{
  "name": "fsspec-browser",
  "version": "0.3.0",
  "description": "terminal and web browser for fsspec backends",
  "repository": "git@github.com:1kbgz/fsspec-browser.git",
  "author": "the fsspec-browser authors <dev@1kbgz.com>",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "unpkg": "dist/cdn/index.js",
  "jsdelivr": "dist/cdn/index.js",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "default": "./dist/esm/index.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*"
  ],
  "types": "./dist/esm/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:clean": "node -e \"const fs=require('fs'); fs.rmSync('dist',{recursive:true,force:true}); fs.rmSync('../fsspec_browser/extension',{recursive:true,force:true})\"",
    "build:debug": "node build.mjs --debug",
    "build:prod": "node build.mjs",
    "build:types": "tsc",
    "build": "npm-run-all build:clean build:prod build:types",
    "clean": "rm -rf dist lib playwright-report ../fsspec_browser/extension",
    "dev": "npm-run-all -p start watch",
    "lint:js": "oxlint . && oxfmt --check \"src/**/*.{js,ts,jsx,tsx,css}\" \"tests/**/*.{js,ts,jsx,tsx}\" \"*.mjs\" \"*.json\"",
    "lint": "pnpm run lint:js",
    "fix:js": "oxlint --fix . && oxfmt --write \"src/**/*.{js,ts,jsx,tsx,css}\" \"tests/**/*.{js,ts,jsx,tsx}\" \"*.mjs\" \"*.json\"",
    "fix": "pnpm run fix:js",
    "preinstall": "npx only-allow pnpm",
    "prepack": "pnpm run build",
    "start": "http-server -p 3000 -o examples/",
    "start:tests": "http-server -p 3000 ",
    "test:js": "playwright test",
    "test": "pnpm run test:js",
    "watch": "nodemon --watch src -e ts,css,html --exec \"pnpm build:debug\""
  },
  "dependencies": {
    "@pierre/trees": "1.0.0-beta.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "cpy": "^13.2.2",
    "esbuild": "^0.28.1",
    "http-server": "^14.1.1",
    "lightningcss": "^1.33.0",
    "nodemon": "^3.1.10",
    "npm-run-all": "^4.1.5",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "typescript": "^7.0.2"
  }
}
